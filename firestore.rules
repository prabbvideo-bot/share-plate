rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles (strictly owner read and write)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().id == userId
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 150
        && incoming().accountType in ['resident', 'restaurant', 'mess', 'darshini', 'sweetstall', 'mandi']
        && incoming().locality is string && incoming().locality.size() <= 150;
      allow update: if isOwner(userId)
        && incoming().id == userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'locality', 'city', 'phone', 'bringDabbaDefault', 'accountType']);
      allow delete: if false;
    }

    // Food Listings (Public read so neighbors can view local surplus; authenticated create/update)
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().title is string && incoming().title.size() <= 150
        && incoming().posterName is string && incoming().posterName.size() <= 100
        && incoming().quantityRemaining is number && incoming().quantityRemaining >= 0;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }

    // Claims (User can view, create, and update their own claims)
    match /claims/{claimId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().claimCode is string && incoming().claimCode.size() <= 20;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
